{
  "opencollection": "1.0.0",
  "info": {
    "name": "ShootProof Studio API (Curated Subset) Clients Photos API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://auth.shootproof.com/oauth2/authorization/new",
      "accessTokenUrl": "https://auth.shootproof.com/oauth2/authorization/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
