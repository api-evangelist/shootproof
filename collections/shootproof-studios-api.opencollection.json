            "method": "GET",
            "url": "https://api.shootproof.com/studio/brand"
          },
          "docs": "List all of a studio's brands"
        },
        {
          "info": {
            "name": "Get a brand",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.shootproof.com/studio/brand/:brandId",
            "params": [
              {
                "name": "brandId",
                "value": "",
                "type": "path",
                "description": "The ID of the brand."
              }
            ]
          },
          "docs": "Get a brand"
        },
        {
          "info": {
            "name": "Partially update a brand",
